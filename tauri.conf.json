{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDMspor",
  "version": "1.0.0",
  "identifier": "com.kdmspor.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KDMspor",
        "width": 1280,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "KDM dogrulama",
    "longDescription": "Salonlari kendi sertifikalarindan tanimlar, KDM dosyalarini seans listesiyle karsilastirir, dogru olanlari klasorler."
  }
}
